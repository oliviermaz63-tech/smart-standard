# --- Frontend (Vite) ---
# URL du backend.
# En local : http://localhost:3001
# En production (Vercel) : déjà configurée sous le nom VITE_API_URL,
# doit pointer vers l'URL Railway du backend déployé,
# ex: https://smart-standard-production.up.railway.app
VITE_API_URL=http://localhost:3001

# Clé d'application envoyée à chaque appel API (header X-App-Key), pour
# limiter les appels directs à l'API en dehors de l'appli. Doit avoir
# EXACTEMENT la même valeur que APP_SHARED_KEY ci-dessous côté backend.
# Ce n'est pas un vrai secret (elle est visible dans le JS envoyé au
# navigateur) : elle bloque surtout les scripts/bots qui tapent l'API
# au hasard, pas une personne déterminée à l'extraire du code.
#
# ORDRE DE DÉPLOIEMENT IMPORTANT (pour ne jamais casser l'appli) :
#   1. Choisis une valeur (ex: une longue chaîne aléatoire).
#   2. Configure-la d'abord ICI, en VITE_APP_KEY sur Vercel, et redéploie
#      le frontend. Sans APP_SHARED_KEY configuré côté backend, ça ne
#      change rien pour l'instant (la vérification y est encore désactivée).
#   3. Configure ENSUITE la même valeur en APP_SHARED_KEY sur Railway
#      (voir plus bas) et redéploie le backend. À partir de là, la
#      protection est active — et le frontend envoie déjà la bonne clé.
VITE_APP_KEY=change-me-with-a-long-random-string

# --- Backend (Express / server.js) ---
# --- IA : Claude (Anthropic) par défaut dès que ANTHROPIC_API_KEY est défini,
# sinon OpenAI (repli, pour ne rien casser pendant la mise en place).
# Clé API Claude (console.anthropic.com > API Keys). Jamais commitée.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optionnel : forcer le fournisseur ("anthropic" ou "openai") et les modèles.
# AI_PROVIDER=anthropic
# CLAUDE_MODEL_FAST=claude-haiku-5-5     (texte : le plus rapide)
# CLAUDE_MODEL_SMART=claude-sonnet-5-5   (analyse des images de vidéo)

# Clé API OpenAI (repli ; jamais commitée, jamais partagée)
OPENAI_API_KEY=your_openai_api_key_here

# Doit être IDENTIQUE à VITE_APP_KEY ci-dessus. Tant que cette variable
# n'est pas définie sur Railway, la vérification de clé reste désactivée
# (aucune casse possible pendant la mise en place — voir l'ordre ci-dessus).
APP_SHARED_KEY=change-me-with-a-long-random-string

# Domaines autorisés à appeler l'API depuis un navigateur (CORS), séparés
# par des virgules. localhost est toujours autorisé automatiquement (dev).
# Par défaut (si absent) : https://smart-standard.vercel.app
ALLOWED_ORIGINS=https://smart-standard.vercel.app

# Port du serveur backend en local (Railway définit automatiquement le sien)
PORT=3001
